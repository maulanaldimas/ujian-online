rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: pengguna sudah login
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: akun admin (peran 'admin' di koleksi adminUsers)
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: peserta pemilik dokumen
    function isOwnerPeserta() {
      return isSignedIn()
        && resource.data.pesertaAuthUid == request.auth.uid;
    }

    match /adminUsers/{uid} {
      // Hanya admin yang bisa membaca/menambah akun admin
      allow read, write: if isAdmin();
    }

    match /soalUjian/{soalId} {
      // Peserta perlu membaca soal saat ujian; hanya admin yang boleh menulis
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /kunciJawaban/{soalId} {
      // Kunci jawaban bersifat rahasia: hanya admin
      allow read, write: if isAdmin();
    }

    match /pengaturan/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
    }

    match /pesertaUjian/{pesertaId} {
      // Peserta hanya bisa membuat dokumen miliknya sendiri
      allow create: if isSignedIn()
        && request.resource.data.pesertaAuthUid == request.auth.uid;

      // Peserta membaca/mengubah datanya sendiri; admin mengakses semua
      allow read, update: if isSignedIn() && (isOwnerPeserta() || isAdmin());

      // Hanya admin yang boleh menghapus
      allow delete: if isAdmin();
    }

    match /penilaianEsai/{penilaianId} {
      // Penilaian esai hanya dikelola admin (HR)
      allow read, write: if isAdmin();
    }
  }
}
