# .env.example — Ujian Online Rekrutmen
# Copy this file to .env and adjust values.
# NEVER commit the actual .env file to the repository.

# Database
# SQLite (local dev):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@host:5432/ujian_rekrutmen"

# JWT Secret — MUST be changed in production!
JWT_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"

# App Config
NEXT_PUBLIC_APP_NAME="Ujian Online Rekrutmen"
