# Firebase configuration — salin file ini menjadi `.env.local` lalu isi nilainya.
# Jangan pernah meng-commit file `.env.local` ke repository.
# Cara mendapatkan nilai: Firebase Console → Project Settings → Your apps → SDK setup.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
